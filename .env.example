# Database
DATABASE_URL="postgresql://user:password@localhost:5432/probook_web?schema=public"   # Pooled (pgBouncer) URL used by the app
DIRECT_URL="postgresql://user:password@localhost:5432/probook_web?schema=public"     # Direct (non-pooled) URL — required for prisma migrate (DDL fails through pgBouncer)

# Auth
JWT_SECRET="generate-a-random-64-char-string-here"
TOTP_ENCRYPTION_KEY="generate-a-separate-random-64-char-string"  # Encrypts stored TOTP secrets. Set BEFORE rotating JWT_SECRET or 2FA secrets become undecryptable.
INVOICE_INTEGRITY_SECRET=    # Optional: HMAC key for invoice integrity hashes (falls back to JWT_SECRET)

# File storage (Cloudflare R2) — company logos and product photos
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-token-access-key-id"          # R2 API token: Object Read & Write, this bucket only
R2_SECRET_ACCESS_KEY="r2-token-secret-access-key"
R2_BUCKET="probook-uploads"
R2_PUBLIC_URL="https://files.probookapp.net"       # the bucket's custom domain, no trailing slash

# Email (Resend)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Probook <noreply@yourdomain.com>"

# App
NEXT_PUBLIC_APP_NAME="Probook"
NEXT_PUBLIC_SITE_URL="https://probookapp.net"   # Used for SEO, sitemap, OG image URLs
NEXT_PUBLIC_APP_URL="https://www.probookapp.net"    # Used in email links (verification, password reset)
NEXT_PUBLIC_API_URL=                             # Optional: API base URL override (defaults to same origin)

# Rate limiting (Upstash Redis — required in production for effective limits;
# falls back to per-instance in-memory when unset, e.g. local dev/tests)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled jobs (Vercel Cron sends this as a Bearer token to /api/cron/*)
CRON_SECRET=

# Secured cash journal (art. 286 I 3° bis CGI), src/lib/pos-journal.ts
POS_JOURNAL_SECRET=          # HMAC key sealing the journal; falls back to INVOICE_INTEGRITY_SECRET / JWT_SECRET. Never rotate it: old entries would stop verifying
# Publisher's identity printed on the attestation a merchant downloads (BOI-LETTRE-000242).
# The attestation engages the publisher: it is offered only once all four are set.
FISCAL_EDITOR_COMPANY=       # Raison sociale of the publisher
FISCAL_EDITOR_REPRESENTATIVE= # NOM Prénom of its legal representative
FISCAL_EDITOR_CITY=          # "Fait à …"
FISCAL_EDITOR_MARKET_DATE=   # YYYY-MM-DD: when version 1 of the cash features was put on the market

# Admin Seed
PLATFORM_ADMIN_PASSWORD=     # Password for the initial platform admin account

# Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=      # Get from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_AUTH_TOKEN=           # Optional: for source map uploads (Settings → Auth Tokens)
SENTRY_ORG=                  # Optional: your Sentry org slug
SENTRY_PROJECT=              # Optional: your Sentry project slug
DISCORD_ALERT_WEBHOOK_URL=   # Optional: Discord webhook (channel settings → Integrations → Webhooks); server/edge errors sent to Sentry are also pinged there. Set it in the Production scope only.

# Test environment only (.env.test) — never set these in production
# next dev also reads .env for anything .env.test leaves out, so blank the
# production Sentry DSN/tokens there (NEXT_PUBLIC_SENTRY_DSN= etc.) and add:
# EMAIL_DRIVER=log          # write emails to the server log instead of sending
# STORAGE_DRIVER=inline     # store uploads as data: URLs (the test env has no bucket)
